# === Shared Firebase Configuration ===
# Both apps use the same Firebase project (wesplit-35186)

# Extension uses VITE_ prefix
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=wesplit-35186.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wesplit-35186
VITE_FIREBASE_STORAGE_BUCKET=wesplit-35186.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Web app uses NEXT_PUBLIC_ prefix
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wesplit-35186.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wesplit-35186
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wesplit-35186.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# === Solana RPC ===
VITE_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
