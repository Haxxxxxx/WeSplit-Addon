{
  "name": "wesplit-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=300",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && NODE_ENV=development electron electron/main.js\"",
    "electron:build": "npm run build && electron-builder --mac",
    "electron:build:dmg": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "xyz.wesplit.app",
    "productName": "WeSplit",
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.icns"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      ".next/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@phosphor-icons/react": "^2.1.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@solana/spl-token": "^0.4.12",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-walletconnect": "^0.1.21",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tma.js/sdk-react": "^3.0.15",
    "bip39": "^3.1.0",
    "bs58": "^5.0.0",
    "clsx": "^2.1.1",
    "ed25519-hd-key": "^1.3.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.6.1",
    "framer-motion": "^12.12.2",
    "grammy": "^1.41.1",
    "next": "^15.3.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "resend": "^6.9.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bs58": "^4.0.4",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^9.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.0",
    "wait-on": "^8.0.0"
  }
}
