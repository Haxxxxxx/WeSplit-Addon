# =============================================================================
# WeSplit Web — Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# --- Firebase (Public — safe to expose in client bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wesplit-35186.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wesplit-35186
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wesplit-35186.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER ONLY — NEVER expose to client) ---
# REQUIRED for all API routes (auth, telegram, wallet-transfer)
# Generate from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON string here (or set as a base64-encoded string)
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Telegram Bot (SERVER ONLY) ---
# REQUIRED for Telegram Mini App authentication (HMAC-SHA256 validation)
# Get from @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=

# --- Email Service (SERVER ONLY) ---
# REQUIRED for email OTP in Telegram account linking
# Get from https://resend.com → API Keys
RESEND_API_KEY=
# The "from" address for OTP emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@wesplit.xyz

# --- App URL ---
# REQUIRED for wallet transfer QR codes (used to build the QR payload URL)
# In development: http://localhost:3000
# In production: https://app.wesplit.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Solana Network ---
# Set to "mainnet-beta" for production, "devnet" for development
NEXT_PUBLIC_NETWORK=devnet
# Set to "true" to force mainnet regardless of NEXT_PUBLIC_NETWORK
NEXT_PUBLIC_FORCE_MAINNET=false

# --- Telegram Webhook (SERVER ONLY) ---
# REQUIRED for production — validates incoming webhook requests from Telegram
# Set this when registering the webhook with Telegram's setWebhook API
TELEGRAM_WEBHOOK_SECRET=

# --- Solana RPC Endpoints (SERVER ONLY — proxied via /api/rpc) ---
# API keys stay server-side. Client uses /api/rpc proxy automatically.
# At least one RPC URL is recommended for production reliability.
HELIUS_RPC_URL=
ALCHEMY_RPC_URL=
GETBLOCK_RPC_URL=
DEVNET_RPC_URL=

# --- Optional: Analytics / Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
