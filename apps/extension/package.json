{
  "name": "wesplit-extension",
  "version": "1.0.0",
  "type": "module",
  "description": "WeSplit Browser Extension - Split expenses with crypto on Solana",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run copy-assets",
    "copy-assets": "cp manifest.json dist/ && cp -r public/icons dist/",
    "preview": "vite preview",
    "package": "npm run build && cd dist && zip -r ../wesplit-extension.zip .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "husky install"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^5.0.0",
    "buffer": "^6.0.3",
    "firebase": "^12.9.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@vitest/ui": "^1.0.4",
    "husky": "^9.0.11",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.2.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.11",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^1.0.4"
  }
}
