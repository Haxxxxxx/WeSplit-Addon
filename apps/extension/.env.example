# Firebase Configuration
# Copy this file to .env and fill in your values from the WeSplit Firebase project
# IMPORTANT: Without these, QR code login will NOT work!

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=wesplit-35186.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wesplit-35186
VITE_FIREBASE_STORAGE_BUCKET=wesplit-35186.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Solana RPC URL (REQUIRED - no fallback provided for security)
# Alchemy format: https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Get a free API key from: https://www.alchemy.com/
# IMPORTANT: This is required for transaction functionality. Do not commit your API key!
VITE_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
